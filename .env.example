# Copy this file to .env.local and fill in YOUR Supabase project values.
# Never commit .env.local. These two values are public (safe in the browser).

# Supabase project URL (Dashboard -> Project Settings -> API / Data API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ---- Optional, server-only (NO VITE_ prefix) ----
# Only if the server must reach Supabase on a different URL than the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- One-time local use only: `npm run storage:setup` ----
# Secret/service-role key. Add temporarily, run the script, then DELETE it.
# Never add it to Vercel and never prefix it with VITE_.
SUPABASE_SECRET_KEY=
